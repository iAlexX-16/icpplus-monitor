# Copia este archivo a .env para las pruebas locales.
# En GitHub, guarda estos valores en Settings > Secrets and variables > Actions.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ICP_NIE=
ICP_FULL_NAME=
# Texto exacto del país en el desplegable, por ejemplo CHINA.
ICP_NATIONALITY=

# Canal de correo opcional (puede quedar vacío si usas Telegram).
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=
ALERT_EMAIL_TO=
